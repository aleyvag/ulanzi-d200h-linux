# Credenciales OAuth2 de Spotify para el handler `host_action: type: spotify`.
#
# 1) Copia este archivo a config/secrets/spotify.yaml (o deja que
#    `d200h convert` lo pre-rellene desde un .ulanziDeckProfile).
# 2) Rellena `client_id` y `client_secret` con los de tu app en
#    https://developer.spotify.com/dashboard (la app debe tener
#    "http://127.0.0.1:30901/oauth2callback" en Redirect URIs).
#    Las credenciales del software oficial de Ulanzi en Windows también
#    funcionan, pero ese es un canal compartido — para uso personal vale.
# 3) Corre:  uv run d200h spotify-auth
#    Esto abrirá tu navegador, autorizará al bridge contra Spotify y
#    escribirá el `refresh_token` en este mismo archivo.
#
# Activación en runtime: si este archivo existe (y D200H_SPOTIFY no
# está en 0/false/off/no), el bridge inicializa el cliente. Si falta
# refresh_token, los slots Spotify abren un popup informativo al
# pulsarse en vez de crashear.

client_id: ""
client_secret: ""
refresh_token: ""
scope: "user-modify-playback-state user-read-playback-state user-library-modify user-library-read"
obtained_at: 0
